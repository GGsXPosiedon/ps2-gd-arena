# Pick ONE AI provider. With none set, the app runs in offline mock mode (scripted lines).

# Google Gemini (free tier works: https://aistudio.google.com/apikey)
# LLM_PROVIDER pins the provider so other keys in your shell (e.g. ANTHROPIC_API_KEY) are never used by accident.
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# or Anthropic Claude (set LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=

# or any OpenAI-compatible API (Groq, OpenRouter, Ollama, OpenAI; remove LLM_PROVIDER)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=

# Optional overrides
# LLM_PROVIDER=mock   # force offline mock mode (used by e2e tests)
# LLM_MODEL_FAST=gemini-2.5-flash-lite   # AI participants' turns
# LLM_MODEL_SMART=gemini-2.5-flash       # feedback report

# Optional: natural cloud voices via Gemini TTS (needs GEMINI_API_KEY; free-tier quota is small)
# TTS_PROVIDER=gemini
# GEMINI_TTS_MODEL=
