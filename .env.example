# Pick ONE AI provider. With none set, the app runs in offline mock mode (scripted lines).

# Google Gemini (free tier works: https://aistudio.google.com/apikey)
# LLM_PROVIDER pins the provider so other keys in your shell (e.g. ANTHROPIC_API_KEY) are never used by accident.
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# or Anthropic Claude (set LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=

# or any OpenAI-compatible API (Groq, OpenRouter, Ollama, OpenAI; remove LLM_PROVIDER)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=

# Optional overrides
# LLM_PROVIDER=mock   # force offline mock mode (used by e2e tests)
# LLM_MODEL_FAST=gemini-3.5-flash-lite   # AI participants' turns (default; ~1-1.5 s per reply on the free tier)
# LLM_MODEL_SMART=gemini-3.5-flash       # feedback report (default; falls back to 3.6 Flash, then 3.5 Flash Lite)
# GEMINI_API_KEY_2=   # optional second key (another project) tried when the first is rate-limited
# LLM_FALLBACK=none   # with SARVAM_API_KEY set, Sarvam's chat model takes over when every Gemini model fails; this turns it off

# Natural Indian voices for the AI seats (recommended). Pick one:
# TTS_PROVIDER=sarvam   + SARVAM_API_KEY=      (https://dashboard.sarvam.ai, Indian voices, natural Hinglish)
# TTS_PROVIDER=google   + GOOGLE_TTS_API_KEY=  (Google Cloud API key with Text-to-Speech enabled; en-IN Chirp 3 HD voices)
# Speech-to-text for your turns uses SARVAM_API_KEY (saaras), falling back to GEMINI_API_KEY; override with SARVAM_STT_MODEL / SARVAM_STT_MODE.
# Without these, browser voices are used (best in Microsoft Edge: "Natural" en-IN voices).

# Optional: cloud voices via Gemini TTS. Not recommended for the live room yet: the free tier allows ~10 requests/day
# and generation measured ~8 s for a 5 s line. Browser voices (best in Edge: "Natural" en-IN voices) are instant and free.
# TTS_PROVIDER=gemini
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts   # default (fast); gemini-3.8-flash-tts sounds more expressive but is slower
